# 静的ファイル(SPA本体・画像・フォントなど)に付けるヘッダー。
# assets.run_worker_first を ["/api/*"] に絞ったため、これらのパスはWorkerを経由せず
# Cloudflareのアセット配信がこのファイルの内容をもとにヘッダーを付ける。
# /api/* のヘッダーは src/worker/middleware/security-headers.ts で付けている。
# 値は src/shared/security-headers.ts と一致させること(test/frontend/security-headers-file.test.ts で確認)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy-Report-Only: default-src 'self'; font-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src-elem 'self'; style-src-attr 'unsafe-inline'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# アイコン・Manifest・OGP画像はファイル名にハッシュが付かず、更新時に古いキャッシュが
# 残ると困るため、/assets/* のような長期間のimmutableにはせず短めの期間にする
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-16.png
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/icon-maskable-512.png
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
