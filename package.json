{
	"name": "shukanlog",
	"description": "服薬・運動・カロリーを記録し、週・月で振り返る個人向けの健康習慣記録サービス",
	"dependencies": {
		"@fontsource/zen-kaku-gothic-new": "^5.3.0",
		"@fontsource/zen-maru-gothic": "^5.3.0",
		"better-auth": "^1.7.6",
		"drizzle-orm": "^0.45.3",
		"hono": "4.11.1",
		"lucide-react": "^1.48.0",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-router": "^7.18.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@cloudflare/vitest-plugin": "1.2.7",
		"@eslint/js": "9.39.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"auth": "1.7.6",
		"drizzle-kit": "^0.31.11",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"jsdom": "^30.1.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"vitest": "^4.1.11",
		"wrangler": "4.138.0"
	},
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "npm run build && vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"deploy:production": "wrangler d1 migrations apply DB --remote --env production && npm run build && wrangler deploy --env production"
	},
	"type": "module"
}
