{
	"name": "shukanlog",
	"description": "服薬・運動・カロリーを記録し、週・月で振り返る個人向けの健康習慣記録サービス",
	"dependencies": {
		"hono": "4.11.1",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-router-dom": "7.18.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@eslint/js": "9.39.1",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"wrangler": "4.138.0"
	},
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "npm run build && vite preview",
		"test": "echo \"T2でテスト環境を用意してから設定する\"",
		"test:watch": "echo \"T2でテスト環境を用意してから設定する\"",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"cf-typegen": "wrangler types",
		"db:generate": "echo \"T4でdrizzleを用意してから設定する\"",
		"db:migrate:local": "echo \"T4でdrizzleを用意してから設定する\""
	},
	"type": "module"
}
