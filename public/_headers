# 静的ファイル(SPA本体・画像・フォントなど)に付けるヘッダー。
# assets.run_worker_first を ["/api/*"] に絞ったため、これらのパスはWorkerを経由せず
# Cloudflareのアセット配信がこのファイルの内容をもとにヘッダーを付ける。
# /api/* のヘッダーは src/worker/middleware/security-headers.ts で付けている。
# 値は src/shared/security-headers.ts と一致させること(test/frontend/security-headers-file.test.ts で確認)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy-Report-Only: default-src 'self'; font-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com

/assets/*
  Cache-Control: public, max-age=31536000, immutable
