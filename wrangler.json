/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shukanlog",
	"main": "./src/worker/index.ts",
	// compatibility_date は作業日の日付にする(既知の落とし穴1: 2026-03-03より前だと
	// Better Authのログイン失敗時に「未処理のPromise拒否」が誤検知されテストが失敗する)
	"compatibility_date": "2026-08-18",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		// /api/ 配下のみWorkerを先に実行する。それ以外の静的ファイル(日本語フォントなど細かいファイルを含む)は
		// Workerを経由せず直接配信する(1回の画面表示でWorkerが何十回も動くのを避け、無料枠の消費を抑える)。
		// 静的ファイルのヘッダーは public/_headers で付ける(既知の落とし穴3)
		"run_worker_first": ["/api/*"],
		"not_found_handling": "single-page-application"
	},

	// 開発用(トップレベル)の環境変数・バインディング
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:5173",
		"MAIL_TRANSPORT": "console",
		"MAIL_FROM_ADDRESS": "noreply@example.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shukanlog-dev",
			// 開発用DBの実体はT4でローカルにセットアップする(ローカル実行のみのためIDは仮のまま)
			"database_id": "REPLACE_WITH_DEV_D1_DATABASE_ID",
			"migrations_dir": "./migrations"
		}
	],
	"ratelimits": [
		{
			// 記録APIの書き込み(POST/PUT/PATCH/DELETE)にユーザーID単位でかけるレート制限(period は 10 か 60 のみ指定可能)。
			// 60秒に300回は書き込み専用の制限としては大きすぎる(通常の利用では1分間にそこまで書き込まない)ため、
			// 60秒に60回に見直した(T10)。ログイン試行回数などの細かい制限はBetter Auth側のcustomRulesで行う(既知の落とし穴5)
			"name": "API_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 }
		}
	],

	// 本番環境。バインディングは環境ごとに再定義が必要(トップレベルからは引き継がれない)
	"env": {
		"production": {
			"vars": {
				"BETTER_AUTH_URL": "https://shukanlog.com",
				"MAIL_TRANSPORT": "cloudflare",
				"MAIL_FROM_ADDRESS": "noreply@shukanlog.com"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "shukanlog-production",
					"database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
					"migrations_dir": "./migrations"
				}
			],
			"send_email": [
				{
					"name": "MAILER",
					// 送信元をnoreply@shukanlog.comのみに限定する(destination_addressは指定しない。
					// 指定すると検証済みの1つの宛先にしか送れなくなり、利用者への送信ができなくなるため)
					"allowed_sender_addresses": ["noreply@shukanlog.com"]
				}
			],
			"ratelimits": [
				{
					"name": "API_RATE_LIMITER",
					"namespace_id": "1002",
					"simple": { "limit": 60, "period": 60 }
				}
			]
		}
	}

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
}
